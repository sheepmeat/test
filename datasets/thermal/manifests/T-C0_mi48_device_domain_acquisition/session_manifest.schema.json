{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safenest.local/schemas/thermal-mi48/session-manifest-v1.json",
  "title": "SafeNest Thermal MI48 session manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "session_id",
    "subject_id",
    "scenario_id",
    "posture_label",
    "human_presence_label",
    "capture_start_time",
    "capture_end_time",
    "sensor_identity",
    "sensor_orientation_or_UNKNOWN",
    "distance_or_UNKNOWN",
    "subject_location_or_UNKNOWN",
    "environment_id_or_UNKNOWN",
    "environment_notes",
    "software_provenance",
    "session_validity",
    "operator_notes"
  ],
  "properties": {
    "schema_version": {"const": "safenest.thermal.mi48.session.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "pattern": "^SESSION-[A-Za-z0-9._-]+$"},
    "subject_id": {"type": "string", "pattern": "^(NONE|SUBJ-[A-Za-z0-9._-]+)$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "posture_label": {"enum": ["NONE", "STANDING", "SITTING", "CROUCHING", "LYING", "OTHER_CONTROLLED", "UNKNOWN"]},
    "human_presence_label": {"enum": ["ABSENT", "PRESENT", "UNKNOWN"]},
    "capture_start_time": {"type": "string", "minLength": 1},
    "capture_end_time": {"type": "string", "minLength": 1},
    "sensor_identity": {"type": "string", "minLength": 1},
    "sensor_orientation_or_UNKNOWN": {"type": "string", "minLength": 1},
    "distance_or_UNKNOWN": {"type": ["string", "number"]},
    "subject_location_or_UNKNOWN": {"type": "string", "minLength": 1},
    "environment_id_or_UNKNOWN": {"type": "string", "minLength": 1},
    "environment_notes": {"type": "string"},
    "software_provenance": {"type": "object", "required": ["collection_tool_version", "git_sha"]},
    "session_validity": {"enum": ["VALID", "INVALID", "PARTIAL", "UNKNOWN"]},
    "operator_notes": {"type": "string"}
  }
}
