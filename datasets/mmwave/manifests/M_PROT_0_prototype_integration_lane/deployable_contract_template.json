{
  "schema_version": "M-PROT-0-DEPLOYABLE-CONTRACT-TEMPLATE-V1",
  "applies_at": "M-PROT-2",
  "freeze_class": "REPRODUCIBILITY_FREEZE_NOT_FINAL_SCIENTIFIC_FREEZE",
  "required_fields": [
    "prototype_version_id",
    "model_artifact_path",
    "model_artifact_sha256",
    "runtime_format",
    "input_shape",
    "input_dtype",
    "window_duration_s",
    "sample_rate_hz",
    "preprocessing_identity",
    "feature_order_or_tensor_layout",
    "output_mapping",
    "prototype_threshold",
    "fail_closed_behavior",
    "mandatory_semantics_tags"
