  "runtime_format_default_expectation": "PyTorch float32 state_dict first; TFLite only if separately evidenced and frozen",
  "threshold_policy": {
    "may_freeze_from_non_final_dev_val_evidence": true,
    "requires_d1_final": false,
    "live_retune_on_same_debug_samples_as_validation": "FORBIDDEN",
    "live_driven_change": "REQUIRES_NEW_PROTOTYPE_VERSION"
  },
  "replacement": "SUBJECT_TO_REPLACEMENT under new M-PROT version"
}
