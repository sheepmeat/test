  "properties": {
    "evidence_scope": {
      "enum": [
        "FIXTURE_NON_CAMPAIGN",
        "LIVE_DEBUG_NON_CAMPAIGN"
      ]
    },
    "scope_semantics": {
      "minItems": 1,
      "type": "array"
    },
    "scope_version": {
      "const": "MMWAVE-V2-D1-EVIDENCE-SCOPE-V1"
    }
  },
  "required": [
    "evidence_scope",
    "scope_version",
    "scope_semantics"
