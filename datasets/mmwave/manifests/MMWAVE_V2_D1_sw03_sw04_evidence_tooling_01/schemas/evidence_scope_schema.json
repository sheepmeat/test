    "LIVE_DEBUG_NON_CAMPAIGN": [
      "NON_CAMPAIGN",
      "NOT_D1_MEMBERSHIP",
      "NOT_FINAL_EVALUATION",
      "NOT_DATASET_ADMISSIBLE_BY_DEFAULT"
